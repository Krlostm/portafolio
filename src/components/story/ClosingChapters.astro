---
import Chapter from "./Chapter.astro";
import Scene from "./Scene.astro";
import Image from "../media/Image.astro";
import Avatar from "../media/Avatar.astro";
import MediaRail from "../media/MediaRail.astro";
import { brands, siteConfig, contactLinks, url } from "../../data/site";
const more = [
  { image: "product-cariocas", name: "Carnaval / Composición comercial" },
  { image: "oper-edad", name: "Opermundo / Redes sociales" },
  { image: "ferre-gas", name: "Ferretería / Publicidad" },
  { image: "thera-anxiety", name: "Theraudio / Contenido con identidad" },
  { image: "ferre-brushes", name: "Diseño comercial / Forma y producto" },
  { image: "thera-course", name: "Theraudio / Redes sociales" },
];
---

<Chapter id="playground" class="playground-chapter">
  <Scene class="playground-scene" label="Más trabajos creativos">
    <div slot="heading">
      <p class="story-kicker">MÁS TRABAJOS / EXPLORACIÓN CREATIVA</p>
      <h2>Más cosas que he creado.</h2>
    </div>
    <MediaRail
      images={more.map((piece) => piece.image)}
      captions={more.map((piece) => piece.name)}
      label="Más trabajos de diseño y composición comercial"
    />
  </Scene>
</Chapter>
<Chapter id="clients" class="clients-chapter">
  <Scene class="clients-scene" label="Marcas y clientes">
    <div slot="heading">
      <p class="story-kicker">CLIENTES / MARCAS</p>
      <h2>
        Marcas con las que
        <br />
        <em>he trabajado.</em>
      </h2>
    </div>
    <div class="clients-marquee">
      <div class="clients-track">
        {[0, 1].map((copy) => (
          <div
            class="clients-set"
            aria-hidden={copy === 1 ? "true" : undefined}
          >
            {brands.map((brand) => (
              <figure
                tabindex={copy === 0 ? 0 : undefined}
                class="client-logo"
                aria-label={copy === 0 ? brand.name : undefined}
              >
                <Image id={brand.image} alt={brand.name} sizes="200px" />
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div slot="footer" class="clients-caption">
      <p>Distintos sectores. Una mirada creativa.</p>
      <button type="button" data-brands-pause aria-pressed="false">
        Pausar marcas Ⅱ
      </button>
    </div>
  </Scene>
</Chapter>
<Chapter id="about" class="about-story">
  <Scene class="about-scene" label="Sobre Carlos Toa">
    <div slot="heading">
      <p class="story-kicker">SOBRE MÍ / CARLOS TOA</p>
      <h2>Una mirada. Muchas formas.</h2>
    </div>
    <div class="about-story-grid">
      <figure class="personal-portrait">
        <Image id="carlos-portrait" sizes="(max-width:1023px) 75vw, 30vw" />
      </figure>
      <div class="about-story-copy">
        <p>{siteConfig.bio}</p>
        <div class="about-capabilities">
          <span>Diseño gráfico</span>
          <span>Animación y edición</span>
          <span>Producción audiovisual</span>
          <span>Fotografía</span>
          <span>Desarrollo</span>
        </div>
        <p class="learning-note">{siteConfig.learningNote}</p>
      </div>
    </div>
    <div slot="footer" class="about-skills">
      <div>
        <p class="about-skills-label" id="software-label">
          PROGRAMAS / HERRAMIENTAS
        </p>
        <ul class="about-skills-list" aria-labelledby="software-label">
          {siteConfig.tools.map((tool) => (
            <li>{tool}</li>
          ))}
        </ul>
      </div>
      <div>
        <p class="about-skills-label" id="web-stack-label">
          LENGUAJES Y TECNOLOGÍAS
        </p>
        <ul class="about-skills-list" aria-labelledby="web-stack-label">
          {siteConfig.webStack.map((language) => (
            <li>{language}</li>
          ))}
        </ul>
      </div>
    </div>
  </Scene>
</Chapter>
<Chapter id="contact" class="contact-story">
  <Scene class="contact-scene" label="Contacto — Carlos Toa">
    <p slot="heading" class="story-kicker">
      CONTACTO / ¿LA PRÓXIMA IDEA?
    </p>
    <div class="contact-content">
      <div class="contact-message">
        <h2>
          Hagamos
          <br />
          algo que
          <br />
          <em>se vea.</em>
        </h2>
        <p>Diseño, video o desarrollo. Cuéntame qué quieres crear.</p>
      </div>
      <div class="story-contact-links">
        <a class="contact-card contact-card-email" href={contactLinks.email}>
          <span class="contact-channel">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3" />
              <path d="m4 7 8 6 8-6" />
            </svg>
            CORREO
          </span>
          <strong>{siteConfig.email}</strong>
          <span class="contact-action">Enviar un correo</span>
          <i aria-hidden="true">↗</i>
        </a>
        <a
          class="contact-card contact-card-whatsapp"
          href={contactLinks.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-channel">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 11.5a9 9 0 0 1-9 9 9.3 9.3 0 0 1-4-.9L3 21l1.4-4.7a9 9 0 1 1 16.6-4.8Z" />
              <path d="M8 8.5c.8 3.2 2.3 4.7 5.5 5.5l1.5-1.5 2 1c0 1.3-.7 2.5-2.5 2.5C10 15.5 7 12.5 6.5 8c0-1.8 1.2-2.5 2.5-2.5l1 2L8 8.5Z" />
            </svg>
            WHATSAPP
          </span>
          <strong>{siteConfig.phone}</strong>
          <span class="contact-action">Abrir conversación</span>
          <i aria-hidden="true">↗</i>
        </a>
        {siteConfig.github && (
          <a
            class="contact-card"
            href={siteConfig.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-channel">GITHUB</span>
            <strong>Ver perfil</strong>
            <i aria-hidden="true">↗</i>
          </a>
        )}
      </div>
    </div>
    <div slot="footer" class="story-footer">
      <Avatar href={url("#start")} label="Volver al inicio" />
      <span>DISEÑO / ANIMACIÓN / PRODUCCIÓN / FOTOGRAFÍA / DESARROLLO</span>
      <a href={url("#start")}>VOLVER AL INICIO ↑</a>
    </div>
  </Scene>
</Chapter>
