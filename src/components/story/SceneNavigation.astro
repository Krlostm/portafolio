<nav
  class="scene-navigation"
  data-scene-navigation
  aria-label="Navegar por escenas"
  hidden
>
  <button type="button" data-scene-prev aria-label="Escena anterior">
    ↑
  </button>
  <button type="button" data-scene-next aria-label="Escena siguiente">
    ↓
  </button>
  <button
    type="button"
    class="scene-mode-toggle"
    data-scene-toggle
    aria-pressed="true"
  >
    Desplazamiento libre
  </button>
  <span
    class="sr-only"
    data-scene-announcement
    aria-live="polite"
    aria-atomic="true"
  ></span>
</nav>
